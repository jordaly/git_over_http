{
  "version": 1,
  "pipelines": [
    {
      "name": "checks",
      "execution": {
        "runner": "docker", "image": "python:3.14-slim", "timeout_seconds": 600, "source_limit_mb": 100,
        "image_build": null,
        "limits": {"log_mb": 1, "artifact_mb": 16, "artifact_uncompressed_mb": 20, "artifact_files": 1000, "source_timeout_seconds": 60, "transfer_timeout_seconds": 60, "image_pull_timeout_seconds": 600},
        "docker": {"cpus": 1, "memory_mb": 1024, "pids_limit": 128, "tmpfs_mb": 256, "network": "none", "read_only": true}
      },
      "cancellation": {"superseded": true},
      "triggers": {
        "push": {"enabled": true, "branches": ["main", "develop", "release/*"]},
        "pull_request": {"enabled": true, "branches": ["main", "develop"], "events": ["opened", "updated", "reopened", "merged"]}
      },
      "steps": [
        {"name": "Check Python version", "run": "python --version"},
        {"name": "Run tests", "run": "python -m unittest discover -v"},
        {"name": "Compile source", "run": "python -m compileall -q ."}
      ],
      "artifacts": {"paths": ["reports/**/*.xml", "coverage/*"], "when": "always"},
      "notifications": {"email": {"mode": "off", "recipients": ["ci@example.com", "ops@example.com"]}}
    },
    {
      "name": "release-build",
      "execution": {"runner": "docker", "image": "python:3.14-slim", "timeout_seconds": 900},
      "cancellation": {"superseded": false},
      "triggers": {"push": {"enabled": true, "branches": ["main", "release/*"]}},
      "steps": [{"name": "Tests", "run": "python -m unittest discover -v"}],
      "artifacts": {"paths": ["dist/*"], "when": "success"},
      "notifications": {"email": {"mode": "off", "recipients": []}}
    }
  ],
  "deployments": [
    {"name": "staging", "pipeline": "checks", "enabled": false, "branch": "develop", "steps": [{"name": "Release staging", "run": "/opt/deploy/staging.sh"}, {"name": "Check health", "run": "curl --fail http://localhost:8080/health"}], "timeout_seconds": 600},
    {"name": "production", "pipeline": "release-build", "enabled": false, "branch": "main", "script": "/opt/deploy/production.sh", "run_with": "bash -e", "timeout_seconds": 900, "notifications": {"email": {"mode": "off", "recipients": ["ops@example.com"]}}}
  ],
  "policies": {
    "require_ci": false,
    "block_direct_pushes": false,
    "protected_branches": ["main", "release/*"],
    "merge_methods": ["merge", "squash", "rebase", "ff"],
    "required_approvals": 1,
    "dismiss_stale_approvals": true,
    "block_on_changes_requested": true,
    "require_conversation_resolution": false
  },
  "retention": {"artifacts": {"days": 30, "max_count": 50}, "runs": {"max_count": 100}}
}
